	observe(observe)
	extract_intent(extract_intent)
	clarify(clarify)
	start_shopping(start_shopping)
	shop(shop)
	verify(verify)
	finish(finish)
	__end__([<p>__end__</p>]):::last
	__start__ --> observe;
	clarify --> extract_intent;
	extract_intent -.-> clarify;
	extract_intent -.-> start_shopping;
	observe --> extract_intent;
	shop -.-> finish;
	shop -.-> verify;
	start_shopping --> shop;
	verify -.-> finish;
	verify -.-> shop;
	finish --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
