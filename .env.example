# Kroger Developer application (product and location reads)
KROGER_CLIENT_ID=replace_with_your_client_id
KROGER_CLIENT_SECRET=replace_with_your_client_secret

# Register this exact URI for the same Kroger application, with Cart API enabled.
# Account tokens live in private, git-ignored .kroger-account/, never this file.
KROGER_REDIRECT_URI=http://127.0.0.1:8765/oauth/callback

# Required only when running the DeepSeek-backed agent
DEEPSEEK_API_KEY=replace_with_your_deepseek_api_key

# Required for resumable interactive-choice API sessions (use a long random value)
GROCERY_SESSION_SECRET=replace_with_a_long_random_secret
